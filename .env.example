# Copy to .env and fill in. Never commit the real .env.

# TMDB API key, used by `cinemate enrich-movies` (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Database URL for `import-movielens`, `enrich-movies` and `metrics`; used when
# --database-url is not given. Defaults to sqlite:///cinemate.db
DATABASE_URL=

# Password of the PostgreSQL user for docker compose (required by docker-compose.yml)
POSTGRES_PASSWORD=

# Origins allowed to call the API from a browser (comma-separated, no "*": cookies are used).
# Defaults to http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Recommender parameters (optional; empty = default). Invalid values stop `cinemate serve`.
REC_K=
REC_LAMBDA=
REC_MIN_OVERLAP=
REC_POP_PENALTY=
