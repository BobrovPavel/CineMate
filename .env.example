# Copy to .env and fill in. Never commit the real .env.

# TMDB API key: `cinemate enrich-movies` and the search/add-movie endpoints of `cinemate serve`
# (without it /api/search answers 503). https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Database URL for `import-movielens`, `enrich-movies` and `metrics`; used when
# --database-url is not given. Defaults to sqlite:///cinemate.db
DATABASE_URL=

# Password of the PostgreSQL user for docker compose (required by docker-compose.yml)
POSTGRES_PASSWORD=

# Origins allowed to call the API from a browser (comma-separated, no "*": cookies are used).
# Defaults to http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Secure flag of the session cookie: 1 - when served over HTTPS (1/true/yes/on, 0/false/no/off).
# Empty = off. `cinemate serve --cookie-secure` overrides it.
COOKIE_SECURE=

# Recommender parameters (optional; empty = default). Invalid values stop `cinemate serve` and make `evaluate`/`tune` exit with code 2.
REC_K=
REC_LAMBDA=
REC_MIN_OVERLAP=
REC_POP_PENALTY=
# Significance weighting: similarity is scaled by min(overlap, N) / N; 0 = off (default 0)
REC_SIGNIFICANCE=
# Ratings needed to switch from the popular-by-likes fallback to CF (default 5)
REC_MIN_USER_RATINGS=
# Fallback picks from the top pool_factor * n by likes; 1 = exact top (default 1)
REC_FALLBACK_POOL_FACTOR=
