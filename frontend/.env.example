# Leave empty: the browser calls /api/* on the same origin and Next.js proxies it to the API.
# Set only to send browser requests straight to another origin (then configure CORS_ORIGINS on the API).
NEXT_PUBLIC_API_URL=
# Where the Next.js server forwards /api/* (read at request time). Default http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
